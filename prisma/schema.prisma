generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CalibrationSession {
  id            String   @id @default(cuid())
  userId        String?
  deviceIdHash  String
  sampleRate    Int
  status        String   // started | room_ok | room_warn | completed | aborted
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  metrics       CalibrationMetric[]
  profile       CalibrationProfile?
}

model CalibrationProfile {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  session          CalibrationSession @relation(fields: [sessionId], references: [id])
  noiseFloorDbfs   Float
  rmsTargetMin     Float
  rmsTargetMax     Float
  clipTolerance    Int
  latencyMs        Float
  tunerOffsetCents Float?
  createdAt        DateTime @default(now())
}

model CalibrationMetric {
  id            String   @id @default(cuid())
  sessionId     String
  session       CalibrationSession @relation(fields: [sessionId], references: [id])
  phase         String   // room_check | gain | metrics
  windowMs      Int
  avgRmsDb      Float?
  stdRmsDb      Float?
  clipRate      Float?
  snrDb         Float?
  baseLatencyMs Float?
  noiseFloorDbfs Float?  // For room_check phase specifically
  result        String?  // OK | Fail
  timestamp     DateTime @default(now())
}

// ============================================
// EVALUATION METRICS - Para entrenamiento ML
// ============================================

model EvaluationSession {
  id                String   @id // Reusa sessionId de CalibrationSession
  calibrationId     String   // Referencia al CalibrationSession
  
  // === RANGO VOCAL ===
  rangeSpanSemitones Float?
  rangeMinMidi       Float?
  rangeMaxMidi       Float?
  
  // === ESTABILIDAD / PRECISIÓN / VIBRATO ===
  precisionCents     Float?   // desviación promedio de la nota objetivo
  stabilityCents     Float?   // desviación estándar (qué tan estable)
  vibratoRateHz      Float?   // frecuencia del vibrato
  vibratoDepthCents  Float?   // amplitud del vibrato
  
  // === POTENCIA / CONTROL DINÁMICO ===
  meanRmsDb          Float?   // nivel promedio de señal (dBFS)
  rmsConsistency     Float?   // desviación estándar de RMS (control)
  powerIndex         Float?   // índice de control dinámico (0-1)
  
  // === MÉTRICAS ADICIONALES PARA ML ===
  voiceType          String?  // soprano | alto | tenor | bass (auto-detectado)
  tessituraCenterMidi Float?  // nota más cómoda/frecuente (MIDI)
  spectralCentroid   Float?   // brillo del sonido en Hz (centro de masa espectral)
  dynamicRangeDb     Float?   // diferencia entre momento más fuerte y más suave
  registerShifts     Int?     // número de cambios de registro detectados
  
  // === CALIDAD DE SEÑAL (desde calibración) ===
  snrDb              Float?   // Signal-to-Noise Ratio
  rmsDb              Float?   // RMS de calibración
  
  // === RECOMENDACIÓN (por modelo ML) ===
  recommendedRoute   String?  // CVT (Complete Vocal Technique) | EVM (Estill Voice Model)
  routeConfidence    Float?   // confianza del modelo (0-1)
  
  status             String   @default("in_progress") // in_progress | finalized
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  exercises          ExerciseMetric[]
}

model ExerciseMetric {
  id                String   @id @default(cuid())
  sessionId         String
  session           EvaluationSession @relation(fields: [sessionId], references: [id])
  
  exerciseType      String   // range | stability
  attemptNumber     Int      @default(1)
  
  // Métricas específicas del ejercicio (JSON flexible)
  // Para RANGO: { minMidi, maxMidi, spanSemitones }
  // Para ESTABILIDAD: { precisionCents, stabilityCents, vibratoRateHz, vibratoDepthCents }
  metricsData       Json
  
  // Potencia en este ejercicio
  meanRmsDb         Float?
  rmsConsistency    Float?
  
  durationSeconds   Float?
  completedAt       DateTime @default(now())
  
  @@index([sessionId, exerciseType])
}

// ============================================
// LEARNING MODELS - Módulo de aprendizaje
// ============================================

model VocalTechnique {
  id          String   @id @default(cuid())
  name        String   @unique // "CVT" | "EVM"
  description String
  exercises   VocalExercise[]
  lessons     VocalLesson[]
  students    StudentProgress[]
  createdAt   DateTime @default(now())
}

model VocalLesson {
  id              String   @id @default(cuid())
  techniqueId     String
  technique       VocalTechnique @relation(fields: [techniqueId], references: [id])
  title           String
  description     String
  level           Int      // 1: Beginner, 2: Intermediate, 3: Advanced
  orderIndex      Int      // Orden en la secuencia de aprendizaje
  prerequisites   String[] // IDs de lecciones previas requeridas
  
  // Campos específicos por técnica
  techniqueMode   String   // CVT: "neutral" | "curbing" | "overdrive" | "edge"
                          // EVM: "speech" | "sob" | "twang" | "belt" | "opera"
  
  // Objetivos de aprendizaje
  pitchRange     Json     // { minMidi: number, maxMidi: number }
  dynamicRange   Json     // { minDb: number, maxDb: number }
  
  exercises      LessonExercise[]
  progress       StudentProgress[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([techniqueId, orderIndex])
}

model VocalExercise {
  id            String   @id @default(cuid())
  techniqueId   String
  technique     VocalTechnique @relation(fields: [techniqueId], references: [id])
  name          String
  description   String
  duration      Int      // Duración en segundos
  difficulty    Int      // 1-5
  
  // Parámetros técnicos
  pitchRange    Json    // { minMidi: number, maxMidi: number }
  dynamicRange  Json    // { minDb: number, maxDb: number }
  
  // Objetivos específicos
  targetMetrics Json    // {
                       //   pitchAccuracy: number,    // cents de precisión requerida
                       //   stability: number,         // variación máxima permitida
                       //   vibratoRate?: number,     // Hz objetivo para vibrato
                       //   vibratoDepth?: number     // cents objetivo para vibrato
                       // }
  
  // Contenido del ejercicio
  audioUrl      String?  // URL del audio de ejemplo/guía
  sheetMusic    String?  // URL de la partitura (si aplica)
  instructions  String   // Instrucciones detalladas
  
  lessons       LessonExercise[]
  attempts      ExerciseAttempt[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LessonExercise {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      VocalLesson @relation(fields: [lessonId], references: [id])
  exerciseId  String
  exercise    VocalExercise @relation(fields: [exerciseId], references: [id])
  orderIndex  Int      // Orden en la lección
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([lessonId, orderIndex])
}

model StudentProgress {
  id          String   @id @default(cuid())
  userId      String
  evaluationId String  // Referencia a EvaluationSession
  techniqueId String
  technique   VocalTechnique @relation(fields: [techniqueId], references: [id])
  lessonId    String
  lesson      VocalLesson @relation(fields: [lessonId], references: [id])
  status      String   // "not_started" | "in_progress" | "completed"
  score       Float?   // 0-100
  attempts    ExerciseAttempt[]
  startedAt   DateTime @default(now())
  completedAt DateTime?
  
  // Métricas de progreso
  metrics     Json?    // {
                      //   averageAccuracy: number,
                      //   consistencyScore: number,
                      //   techniqueMastery: number
                      // }

  @@unique([userId, lessonId])
}

model ExerciseAttempt {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  exercise    VocalExercise @relation(fields: [exerciseId], references: [id])
  progressId  String
  progress    StudentProgress @relation(fields: [progressId], references: [id])
  
  // Métricas de rendimiento
  pitchAccuracy   Float?   // Precisión en cents
  stability       Float?   // Estabilidad de la nota
  vibratoRate     Float?   // Tasa de vibrato en Hz
  vibratoDepth    Float?   // Profundidad del vibrato en cents
  dynamicControl  Float?   // Control del volumen
  
  // Análisis técnico
  techniqueScore  Float?   // Puntuación específica de la técnica
  feedback        Json?    // Retroalimentación detallada
  
  audioUrl       String?  // URL del audio grabado
  createdAt      DateTime @default(now())
  duration       Int      // Duración en segundos
  completed      Boolean  @default(false)

  @@index([userId, exerciseId])
}

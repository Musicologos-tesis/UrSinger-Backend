// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String   // Encriptada con bcrypt
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  profile             UserProfile?
  
  @@index([email])
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name                String
  age                 Int
  gender              String   // male | female | other | prefer_not_to_say
  weeklyTrainingFreq  Int      // Frecuencia semanal de entrenamiento (1-7)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  calibrations        Calibration[]
  evaluations         Evaluation[]
  trainingPlans       TrainingPlan[]
  
  @@index([userId])
}

// ============================================
// CALIBRATION
// ============================================

model Calibration {
  id               String   @id @default(cuid())
  profileId        String
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  sessionId        String   @unique  // UUID generado en frontend
  deviceIdHash     String              // Identificador del micrófono
  sampleRate       Int                 // 44100 o 48000
  
  // Valores necesarios para ejercicios vocales
  noiseFloorDbfs   Float               // Ruido ambiente medido
  snrDb            Float?              // Signal-to-Noise Ratio (opcional)
  
  isCurrent        Boolean  @default(false) // La calibración activa del usuario
  
  createdAt        DateTime @default(now())
  
  @@index([profileId, isCurrent])
  @@index([sessionId])
}

// ============================================
// EVALUATION - Métricas de ejercicios vocales
// ============================================

model Evaluation {
  id                String   @id @default(cuid())
  profileId         String
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  sessionId         String   @unique  // sessionId de la calibración usada
  
  // === MÉTRICAS DE VOLUMEN ===
  meanRmsDb         Float    // Nivel promedio de volumen durante la emisión (dBFS)
  rmsConsistency    Float    // Estabilidad del aire y soporte
  dynamicRangeDb    Float    // Diferencia entre volumen más bajo y más alto
  durationSec       Float    // Duración efectiva de la nota o flujo de aire
  
  // === MÉTRICAS DE AFINACIÓN ===
  precisionCents    Float    // Diferencia promedio entre pitch emitido y objetivo
  stabilityCents    Float    // Desviación tonal durante nota sostenida
  
  // === MÉTRICAS DE RANGO VOCAL ===
  rangeMinMidi      Float    // Nota más baja alcanzada
  rangeMaxMidi      Float    // Nota más alta alcanzada
  rangeSpanSemitones Float   // Diferencia entre mínima y máxima
  attackLatencyMs   Float    // Tiempo entre inicio de sonido y estabilización
  
  // === ANÁLISIS DEL MODELO ML ===
  weaknessesDetected String[] // Grupos con carencias detectados: ["weak_G1", "weak_G4"]
  totalWeaknesses   Int      // Cantidad total de carencias detectadas
  confidenceScores  Json     // Scores de confianza por grupo: { "weak_G1": 0.08, ... }
  groupMetrics      Json?    // Métricas por grupo: score, threshold, is_weak, achievement_pct, missing_to_clear_pct
  
  createdAt         DateTime @default(now())
  
  trainingPlans     TrainingPlan[]
  
  @@index([profileId])
  @@index([sessionId])
}

// ============================================
// EJERCICIOS Y GRUPOS DE ENTRENAMIENTO
// ============================================

model ExerciseGroup {
  id          Int    @id @default(autoincrement())
  groupNumber Int    @unique // 1-5 (G1-G5)
  name        String // "Soporte respiratorio y control del aire"
  objective   String // Descripción del objetivo del grupo
  rationale   String @db.Text // Sustento CVT/EVM
  
  exercises   Exercise[]
  
  @@index([groupNumber])
}

model Exercise {
  id              Int    @id @default(autoincrement())
  groupId         Int
  group           ExerciseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  exerciseNumber  Int    // Número dentro del grupo (1, 2, 3...)
  name            String // "Breath Flow Hold"
  rationale       String // "CVT (Support) + EVM (Flow)"
  cvtDescription  String? @db.Text // Descripción del sustento CVT
  evmDescription  String? @db.Text // Descripción del sustento EVM
  objective       String // "Mantener una nota sostenida a volumen estable"
  instructions    String @db.Text // Instrucciones detalladas
  
  levels          ExerciseLevel[]
  
  @@unique([groupId, exerciseNumber])
  @@index([groupId])
}

model ExerciseLevel {
  id          Int    @id @default(autoincrement())
  exerciseId  Int
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  
  level       Int    // 1 o 2
  description String // "Mantén la nota por 3 segundos."
  videoUrl    String? // null por ahora
  
  planExercises TrainingPlanExercise[]
  
  @@unique([exerciseId, level])
  @@index([exerciseId])
}

// ============================================
// PLANES DE ENTRENAMIENTO Y PROGRESO
// ============================================

model TrainingPlan {
  id            String   @id @default(cuid())
  profileId     String
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  evaluationId  String
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  
  startDate     DateTime @default(now())
  endDate       DateTime // startDate + 4 semanas
  frequency     Int      // 3 días por semana (MVP)
  focusGroups   Int[]    // [4, 2] - Grupos con debilidades
  
  status        String   @default("active") // active, completed, replaced
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  exercises     TrainingPlanExercise[]
  
  @@index([profileId, status])
  @@index([evaluationId])
}

model TrainingPlanExercise {
  id              String   @id @default(cuid())
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  exerciseLevelId Int
  exerciseLevel   ExerciseLevel @relation(fields: [exerciseLevelId], references: [id], onDelete: Cascade)
  
  dayOfWeek       Int      // 1=Lunes, 3=Miércoles, 5=Viernes
  orderInDay      Int      // 0, 1, 2 (orden dentro del día)
  
  completionCount Int      @default(0) // 0-4 (cuántas veces se completó en las 4 semanas)
  completedDates  DateTime[] // Array de fechas cuando se completó
  
  createdAt       DateTime @default(now())
  
  @@index([planId, dayOfWeek])
  @@index([planId, completionCount])
}

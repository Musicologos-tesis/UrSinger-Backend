NODE_ENV=development
PORT=3000

# Base de datos local — docker-compose.yml (postgres:16-alpine 5432:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ursinger_db?schema=public

# Servicio ML local — levantar el repo del modelo en este puerto
ML_SERVICE_URL=http://localhost:8000

# CORS — URL del frontend en desarrollo
CORS_ORIGIN=http://localhost:4200

# JWT
JWT_SECRET=local-dev-secret-key-change-for-prod
JWT_EXPIRES_IN=7d
